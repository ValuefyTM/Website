# Claude API — asistentul de evaluare și rezumatul intern al solicitării
ANTHROPIC_API_KEY=
# Modelul folosit de asistent (implicit claude-haiku-4-5)
ASSISTANT_MODEL=claude-haiku-4-5

# Email pentru solicitări (Resend — https://resend.com)
RESEND_API_KEY=
# Unde ajung solicitările
LEAD_EMAIL_TO=contact@valuefy.ro
# Expeditor verificat în Resend, ex. "VALUEFY <solicitari@valuefy.ro>"
LEAD_EMAIL_FROM=

# Date de contact afișate pe site (câmpuri CMS)
NEXT_PUBLIC_PHONE=+40 766 225 936
NEXT_PUBLIC_EMAIL=contact@valuefy.ro
# Numărul autorizației ANEVAR — lăsat gol, nu se afișează
NEXT_PUBLIC_ANEVAR_NO=
# Adresa portalului client
NEXT_PUBLIC_PORTAL_URL=https://portal.valuefy.ro/login
